{
  "name": "hayloft",
  "version": "0.1.0",
  "description": "Hayloft — keep your Harvest. Self-hosted archive of your Harvest time tracking history: projects, tasks, people, time entries, and invoices in a browsable, searchable Postgres-backed web app.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build:css && concurrently -n css,web -c blue,magenta \"npm:build:css:watch\" \"tsx watch src/web/server.ts\"",
    "dev:server": "tsx watch src/web/server.ts",
    "build:css": "tailwindcss -i ./src/web/styles.css -o ./public/styles.css --minify",
    "build:css:watch": "tailwindcss -i ./src/web/styles.css -o ./public/styles.css --watch",
    "build": "npm run build:css",
    "start": "tsx src/web/server.ts",
    "fetch": "tsx src/fetcher/cli.ts",
    "migrate": "tsx src/db/migrate.ts",
    "reindex": "tsx src/scripts/reindex.ts",
    "seed-demo": "tsx src/scripts/seed-demo.ts",
    "hash-password": "tsx src/scripts/hash-password.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^2.4.3",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
