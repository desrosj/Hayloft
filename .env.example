# Harvest API credentials — get from https://id.getharvest.com/developers
HARVEST_ACCOUNT_ID=
HARVEST_ACCESS_TOKEN=
# Harvest asks API clients to include a contact address in the User-Agent.
HARVEST_USER_AGENT="Hayloft (you@example.com)"

# Optional: write expense receipt files to this directory instead of storing
# them in Postgres. The fetcher and the web app must both see the same path.
# Leave empty to keep receipts in the database (recommended for Railway).
RECEIPTS_DIR=

# Web app
APP_PASSWORD_HASH=
SESSION_SECRET=
PORT=3000
NODE_ENV=development

# Postgres connection.
# Local dev (docker-compose):  postgresql://hayloft:dev@localhost:5432/hayloft
# Railway production:          provided automatically as DATABASE_URL when you attach a Postgres service.
DATABASE_URL=postgresql://hayloft:dev@localhost:5432/hayloft
